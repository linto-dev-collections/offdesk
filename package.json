{
  "name": "offdesk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "commands:register": "pnpm -F @offdesk/cli commands:register",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "deploy": "pnpm -F @offdesk/infra deploy",
    "destroy": "pnpm -F @offdesk/infra destroy",
    "dev": "turbo dev --filter=app",
    "format": "biome check --write .",
    "format:ci": "biome ci .",
    "infra:dev": "pnpm -F @offdesk/infra infra:dev",
    "knip": "knip",
    "projects:sync": "pnpm -F @offdesk/cli projects:sync",
    "routine:prompt": "pnpm -F @offdesk/cli routine:prompt",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@offdesk/config": "workspace:*",
    "@types/node": "^24.10.1",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.34.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
