{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "types", "catalog"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@offdesk/config"]
    },
    "apps/app": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
      "ignore": ["src/client/routeTree.gen.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/auth": {
      "entry": ["src/cli/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      // entry は package.json の scripts から knip が自分で拾う（明示すると
      // 「冗長」と hint が出る）。project だけ絞って、置き忘れたファイルを拾わせる。
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "entry": [],
      "project": []
    },
    "packages/contract": {
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "project": ["src/**/*.ts"]
    },
    "packages/infra": {
      "entry": ["alchemy.run.ts"]
    },
    "packages/ui": {
      // `src/components/ui` は `shadcn add` の生成物で編集禁止なので、knip の対象から丸ごと外す。
      // **knip はこの ignore に「Remove from ignore」の hint を出すが、従ってはいけない。**
      // あれは「ファイル単位の指摘なら exports マップ経由で既に到達可能だから不要」という判断で、
      // 依存の宣言漏れ（`ui/` が未宣言の package を import した場合）はこの 1 行だけが止める（実測）。
      "entry": ["src/lib/*.ts", "src/hooks/*.ts", "src/components/block/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/components/ui/**"]
    },
    "packages/usecase": {
      "project": ["src/**/*.ts"]
    }
  }
}
