        "asks_id_shape_ck": {
          "name": "asks_id_shape_ck",
          "value": "\"asks\".\"ask_id\" GLOB 'ask_*'\n       AND substr(\"asks\".\"ask_id\", 5) NOT GLOB '*[^0-9a-f]*'\n       AND length(\"asks\".\"ask_id\") = 20"
        },
        "asks_question_ck": {
          "name": "asks_question_ck",
          "value": "length(\"asks\".\"question\") > 0"
        },
        "asks_options_ck": {
          "name": "asks_options_ck",
          "value": "json_valid(\"asks\".\"options\") AND json_type(\"asks\".\"options\") = 'array'"
        },
        "asks_allow_free_text_ck": {
          "name": "asks_allow_free_text_ck",
          "value": "\"asks\".\"allow_free_text\" IN (0, 1)"
        },
        "asks_answer_pair_ck": {
          "name": "asks_answer_pair_ck",
          "value": "(\"asks\".\"answer\" IS NULL) = (\"asks\".\"answered_at\" IS NULL)"
        },
        "asks_answered_by_ck": {
          "name": "asks_answered_by_ck",
          "value": "\"asks\".\"answered_by_discord_user_id\" IS NULL OR \"asks\".\"answer\" IS NOT NULL"
        },
        "asks_answer_message_ck": {
          "name": "asks_answer_message_ck",
          "value": "\"asks\".\"answer_message_id\" IS NULL OR \"asks\".\"answer\" IS NOT NULL"
        },
        "asks_delivered_ck": {
          "name": "asks_delivered_ck",
          "value": "\"asks\".\"delivered_at\" IS NULL OR \"asks\".\"answered_at\" IS NOT NULL"
