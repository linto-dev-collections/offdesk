# Worker が受け取る環境変数。Vite と wrangler が読み、ローカルでは Worker の env に入る。
# Alchemy CLI だけが使うもの（ALCHEMY_PASSWORD 等）はルートの .env.local に置く。
#
#   cp apps/app/.env.example apps/app/.env.local
#
# .env.local は commit しない。空文字は「未設定」として扱う（写したままでは検査を通らない）。
# 必須かどうかの正本は apps/app/src/worker/env.ts の PRODUCTION_REQUIRED_ENV_NAMES。
# P0 は 0 個。着手するフェーズでコメントを外す。

# P1 — 認証（全部必要。ローカルでも本物の Google OAuth を踏む）
# 署名鍵（openssl rand -base64 32）。**全ステージで必須。**
BETTER_AUTH_SECRET=""
# 公開オリジン。ローカルは http://localhost:5173。**本番で既定値へ倒さない。**
BETTER_AUTH_URL="http://localhost:5173"
# Google Cloud Console の OAuth 2.0 クライアント（ウェブアプリケーション）。
# リダイレクト URI に <オリジン>/api/auth/callback/google を登録する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ログインを許すメール（`,` 区切り）。**空なら誰も通さない**（要件 I-2）。
AUTH_ALLOWED_EMAILS="offdesk.me@gmail.com"

# P2 — Discord とプロジェクト
# DISCORD_BOT_TOKEN=""
# DISCORD_PUBLIC_KEY=""
# DISCORD_APPLICATION_ID=""
# OWNER_DISCORD_USER_ID=""
# FIRE_TOKEN_ENCRYPTION_KEY=""

# P3a — MCP
# MCP_BEARER_TOKEN=""

# P6 — 実装計画の配布
# PLAN_LINK_SIGNING_KEY=""
