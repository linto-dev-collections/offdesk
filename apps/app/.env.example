# Worker が受け取る環境変数。Vite と wrangler が読み、ローカルでは Worker の env に入る。
# Alchemy CLI だけが使うもの（ALCHEMY_PASSWORD 等）はルートの .env.local に置く。
#
#   cp apps/app/.env.example apps/app/.env.local
#
# .env.local は commit しない。空文字は「未設定」として扱う（写したままでは検査を通らない）。
# 必須かどうかの正本は apps/app/src/worker/env.ts の PRODUCTION_REQUIRED_ENV_NAMES。
# P0 は 0 個。着手するフェーズでコメントを外す。

# P1 — 認証（全部必要。ローカルでも本物の Google OAuth を踏む）
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_ALLOWED_EMAILS="owner@example.com"

# P2 — Discord とプロジェクト
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_APPLICATION_ID=""
OWNER_DISCORD_USER_ID=""
OFFDESK_TOKEN=""
FIRE_TOKEN_KEY=""

# P6 — 実装計画の配布
PLAN_LINK_SIGNING_KEY=""

# P7a — 管理画面
# スレッドの URL（https://discord.com/channels/<guild>/<thread>）を組むのに要る。
# 秘密ではない（公開の snowflake）。**未設定でも他の面は動く** —— run 詳細の
# 「スレッドを開く」が出なくなるだけ。開発者モードでサーバー名を右クリックしてコピーする。
DISCORD_GUILD_ID=""
