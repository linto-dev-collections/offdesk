{
  "extends": "@offdesk/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    // 相対 import に `.ts` / `.tsx` を明示する規約にしている（計画 README §2-3）。
    // 拡張子を書けば、解決の仕組み（Vite / tsc / depcruise）が違っても同じ 1 本を指す。
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/types/worker",
    "rootDir": "./src/worker",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": ["src/worker/**/*.ts"],
  "references": [
    { "path": "../../packages/contract" },
    { "path": "../../packages/db" },
    { "path": "../../packages/usecase" }
  ]
}
